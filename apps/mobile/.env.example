# Copy to .env.development (dev project) and .env.production (prod project).
# Only publishable values belong here: everything EXPO_PUBLIC_* ships inside the app.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
