# Local: copy to .env.development. On Vercel: set these per environment
# (Preview -> dev project, Production -> prod project).
# Admin actions run as database functions with the signed-in admin's session,
# so the web app needs no secret key.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
